# Required: use a long random value (12+ characters).
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional; a random value is generated if omitted.
SECRET_KEY=replace-with-a-long-random-secret

# Railway volume mount or another persistent directory.
DATA_DIR=/data

# Optional canonical custom domain used in generated links.
# Set this after attaching your custom domain to Railway.
# PUBLIC_DOMAIN=moon.example.com

# Optional Redis persistence.
# REDIS_URL=redis://default:password@host:6379/0

# Optional cross-origin browser access. Keep empty for same-origin only.
# CORS_ORIGINS=https://example.com

# Optional links shown in the dashboard and subscription headers.
MOON_SUPPORT_URL=https://github.com/<your-username>/moon
MOON_SUPPORT_LABEL=Moon support
